diff --git a/apps/photocraft-web/src/xiaoke.rs b/apps/photocraft-web/src/xiaoke.rs
new file mode 100644
index 0000000..535d620
--- /dev/null
+++ b/apps/photocraft-web/src/xiaoke.rs
@@ -0,0 +1,182 @@
+//! 小柯機器人圖像編輯助手：把引擎接給外層網頁（window.xiaokeEngine）。
+//!
+//! 網頁版沒有 TCP 控制通道，這裡改用同一套 `ControlRequest`，由 JS 排進佇列、每個畫格處理。
+//! - `call(method, paramsJson)`：任何控制方法，回傳 JSON 字串的 Promise
+//! - `render(maxSide)`：目前文件的合成圖 PNG（Uint8Array），沒有文件時為 null
+//! - `selection()`：選取範圍的灰階 PNG（白＝選取），沒有選取時為 null
+//! - `place(name, bytes)`：置入成新圖層；`open(name, bytes)`：開成新文件
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+use std::sync::PoisonError;
+use std::sync::mpsc::{Receiver, Sender};
+
+use photocraft_codecs::{ChannelLayout, EncodeOptions, Format, Image};
+use photocraft_ui_egui::{ControlRequest, PhotocraftApp};
+use serde_json::{Value, json};
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+use crate::web::Inbox;
+
+enum Job {
+    Render(u32, js_sys::Function),
+    Selection(js_sys::Function),
+}
+
+#[derive(Default)]
+struct Queue {
+    jobs: VecDeque<Job>,
+    replies: Vec<(Receiver<Value>, js_sys::Function)>,
+}
+
+#[derive(Clone)]
+pub struct Bridge {
+    queue: Rc<RefCell<Queue>>,
+}
+
+fn bytes_value(bytes: Option<Vec<u8>>) -> JsValue {
+    match bytes {
+        Some(b) => js_sys::Uint8Array::from(b.as_slice()).into(),
+        None => JsValue::NULL,
+    }
+}
+
+fn png(width: u32, height: u32, layout: ChannelLayout, pixels: Vec<u8>) -> Option<Vec<u8>> {
+    let image = Image::from_u8(width, height, layout, pixels).ok()?;
+    photocraft_codecs::encode(&image, Format::Png, &EncodeOptions::default()).ok()
+}
+
+fn set(target: &JsValue, name: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(target, &JsValue::from_str(name), value);
+}
+
+fn deferred(run: impl FnOnce(js_sys::Function) + 'static) -> js_sys::Promise {
+    let mut run = Some(run);
+    js_sys::Promise::new(&mut |resolve, _reject| {
+        if let Some(run) = run.take() {
+            run(resolve);
+        }
+    })
+}
+
+/// 掛上 `window.xiaokeEngine`，回傳每個畫格要處理的 `Bridge`。
+pub fn install(tx: Sender<ControlRequest>, inbox: Inbox, place_inbox: Inbox, ctx: egui::Context) -> Bridge {
+    let queue: Rc<RefCell<Queue>> = Rc::default();
+    let api = js_sys::Object::new();
+
+    let call = {
+        let (queue, ctx) = (queue.clone(), ctx.clone());
+        Closure::<dyn FnMut(String, Option<String>) -> js_sys::Promise>::new(move |method: String, params: Option<String>| {
+            let (queue, ctx, tx) = (queue.clone(), ctx.clone(), tx.clone());
+            deferred(move |resolve| {
+                let params = params.and_then(|p| serde_json::from_str(&p).ok()).unwrap_or(Value::Null);
+                let (req, rx) = ControlRequest::new(method, params);
+                if tx.send(req).is_err() {
+                    let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(r#"{"ok":false,"error":"engine stopped"}"#));
+                    return;
+                }
+                queue.borrow_mut().replies.push((rx, resolve));
+                ctx.request_repaint();
+            })
+        })
+    };
+    set(&api, "call", call.as_ref());
+    call.forget();
+
+    let render = {
+        let (queue, ctx) = (queue.clone(), ctx.clone());
+        Closure::<dyn FnMut(Option<u32>) -> js_sys::Promise>::new(move |max_side: Option<u32>| {
+            let (queue, ctx) = (queue.clone(), ctx.clone());
+            deferred(move |resolve| {
+                queue.borrow_mut().jobs.push_back(Job::Render(max_side.unwrap_or(0), resolve));
+                ctx.request_repaint();
+            })
+        })
+    };
+    set(&api, "render", render.as_ref());
+    render.forget();
+
+    let selection = {
+        let (queue, ctx) = (queue.clone(), ctx.clone());
+        Closure::<dyn FnMut() -> js_sys::Promise>::new(move || {
+            let (queue, ctx) = (queue.clone(), ctx.clone());
+            deferred(move |resolve| {
+                queue.borrow_mut().jobs.push_back(Job::Selection(resolve));
+                ctx.request_repaint();
+            })
+        })
+    };
+    set(&api, "selection", selection.as_ref());
+    selection.forget();
+
+    for (name, target, quiet) in [("place", place_inbox, true), ("open", inbox, false)] {
+        let ctx = ctx.clone();
+        let push = Closure::<dyn FnMut(String, js_sys::Uint8Array)>::new(move |file: String, bytes: js_sys::Uint8Array| {
+            let file = if quiet { format!("xk:{file}") } else { file };
+            target.lock().unwrap_or_else(PoisonError::into_inner).push((file, bytes.to_vec()));
+            ctx.request_repaint();
+        });
+        set(&api, name, push.as_ref());
+        push.forget();
+    }
+
+    // 測試用：開始收集未翻譯字串，再次呼叫回傳清單
+    let missing = Closure::<dyn FnMut() -> js_sys::Array>::new(|| {
+        photocraft_ui_egui::i18n::TRACK_MISSING.store(true, std::sync::atomic::Ordering::Relaxed);
+        photocraft_ui_egui::i18n::missing_strings().into_iter().map(|s| JsValue::from_str(&s)).collect()
+    });
+    set(&api, "missing", missing.as_ref());
+    missing.forget();
+
+    if let Some(window) = web_sys::window() {
+        set(&window, "xiaokeEngine", &api);
+    }
+    Bridge { queue }
+}
+
+impl Bridge {
+    /// 每個畫格：完成排隊的取圖工作，把已有結果的控制回覆交還 JS。
+    pub fn pump(&self, app: &PhotocraftApp, ctx: &egui::Context) {
+        let mut q = self.queue.borrow_mut();
+        while let Some(job) = q.jobs.pop_front() {
+            let doc = app.session.active().map(|d| &d.doc);
+            let (resolve, out) = match job {
+                Job::Render(max_side, resolve) => {
+                    let bytes = doc.and_then(|d| {
+                        let side = if max_side == 0 { d.size.width.max(d.size.height) } else { max_side };
+                        let img = photocraft_compose::thumbnail(d, side.max(1));
+                        png(img.width, img.height, ChannelLayout::Rgba, img.pixels)
+                    });
+                    (resolve, bytes)
+                }
+                Job::Selection(resolve) => {
+                    let bytes = doc.and_then(|d| {
+                        let sel = d.selection.as_ref()?;
+                        let rect = d.bounds();
+                        let channels = sel.channels().max(1);
+                        let gray: Vec<u8> = sel.read_region(rect).chunks_exact(channels).map(|p| (p[0].clamp(0.0, 1.0) * 255.0).round() as u8).collect();
+                        png(rect.width(), rect.height(), ChannelLayout::Gray, gray)
+                    });
+                    (resolve, bytes)
+                }
+            };
+            let _ = resolve.call1(&JsValue::NULL, &bytes_value(out));
+        }
+        q.replies.retain(|(rx, resolve)| match rx.try_recv() {
+            Ok(v) => {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&v.to_string()));
+                false
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => true,
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&json!({"ok": false, "error": "no reply"}).to_string()));
+                false
+            }
+        });
+        if !q.replies.is_empty() {
+            ctx.request_repaint();
+        }
+    }
+}
