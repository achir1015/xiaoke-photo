diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
index c9e1884..4ce7726 100644
--- a/crates/ui-egui/src/i18n.rs
+++ b/crates/ui-egui/src/i18n.rs
@@ -460,7 +460,28 @@ pub fn t(s: &str) -> &str {
 
 /// Translate an English UI string; unknown strings come back unchanged.
 pub fn tr(lang: Lang, s: &str) -> &str {
-    lang.catalog().plain(s).unwrap_or(s)
+    match lang.catalog().plain(s) {
+        Some(t) => t,
+        None => {
+            note_missing(s);
+            s
+        }
+    }
+}
+
+/// 小柯：測試時收集沒有翻譯的字串（平常關閉，不花時間）
+pub static TRACK_MISSING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static MISSING: std::sync::Mutex<std::collections::BTreeSet<String>> = std::sync::Mutex::new(std::collections::BTreeSet::new());
+
+fn note_missing(s: &str) {
+    if TRACK_MISSING.load(std::sync::atomic::Ordering::Relaxed) && s.chars().any(|c| c.is_ascii_alphabetic()) {
+        MISSING.lock().unwrap_or_else(std::sync::PoisonError::into_inner).insert(s.to_string());
+    }
+}
+
+/// 目前收集到的未翻譯字串。
+pub fn missing_strings() -> Vec<String> {
+    MISSING.lock().unwrap_or_else(std::sync::PoisonError::into_inner).iter().cloned().collect()
 }
 
 /// Like [`tr`], for an English string that needs a disambiguating `context`.
